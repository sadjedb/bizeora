# STITCH — environment configuration
#
# Copy to `.env.local` for development. Never commit a real value.
# Only variables the current phase reads are validated by src/lib/env.ts;
# the rest are listed here so the deployment target can be prepared, and are
# added to the schema by the phase that first uses them.

# ---------------------------------------------------------------------------
# Phase 1 — required
# ---------------------------------------------------------------------------

# Absolute public origin, no trailing slash.
# Required in production; defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Phase 2 — database (not yet read by the application)
# ---------------------------------------------------------------------------
#
# Two URLs are required, not one. See docs/ARCHITECTURE.md section 18.
#
# DATABASE_URL   Pooled connection, used by the running application. Serverless
#                functions scale to many concurrent instances, and Postgres
#                allows a few hundred connections in total, so the application
#                must never open direct connections. Point this at the
#                provider's pooler (Neon pooled endpoint, Supabase pgBouncer on
#                port 6543, or PgBouncer in transaction mode) and include
#                `?pgbouncer=true&connection_limit=1` for Prisma.
#
# DIRECT_URL     Unpooled connection, used only by `prisma migrate` and
#                `prisma db push`. Migrations need session-level features that
#                a transaction-mode pooler does not support.
#
# DATABASE_URL="postgresql://user:password@host:6543/stitch?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL="postgresql://user:password@host:5432/stitch?sslmode=require"


# ---------------------------------------------------------------------------
# Phase 3 — authentication (REQUIRED)
# ---------------------------------------------------------------------------
#
# BETTER_AUTH_SECRET  Signs the email-verification JWT and cookie signatures.
#                     32 characters minimum, from a CSPRNG:
#                         openssl rand -base64 32
#                     There is no development default on purpose: a guessable
#                     secret forges a verification token for any address, and a
#                     fallback would eventually reach production. Rotating it
#                     invalidates outstanding verification and reset links.
#                     Never NEXT_PUBLIC_. Never committed.
#
# BETTER_AUTH_URL     Absolute origin for callback URLs. Optional — defaults to
#                     NEXT_PUBLIC_SITE_URL, which is correct for every
#                     environment this project deploys to.
BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Transactional email (Phase 8A)
#
# RESEND_API_KEY plus EMAIL_FROM is what selects the real transport. With
# neither, the application still runs the whole outbox — enqueue, claim,
# render, mark sent — and logs that nothing left the building, with the body
# withheld (SECURITY.md 2.1). Under NODE_ENV=test an in-memory transport is
# used and nothing is sent anywhere.
#
# ADMIN_NOTIFICATION_EMAIL is a bootstrap only. The authoritative recipients
# are the `notifications.adminRecipients` setting, a settings row seeded empty
# (no admin screen edits it yet); this is used while that setting is empty.
#
# JOBS_SECRET authorises the scheduler:
#     POST /api/jobs/notifications
#     Authorization: Bearer $JOBS_SECRET
# Every five minutes is enough. Unset, the endpoint answers 503.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=STITCH <commandes@example.dz>
# ADMIN_NOTIFICATION_EMAIL=
# JOBS_SECRET=


# ---------------------------------------------------------------------------
# SEO (Phase 14)
#
# SEO_INDEXABLE decides whether this deployment may be indexed at all. Unset or
# "false" means every public page carries noindex and robots.txt disallows
# everything — the safe direction, so a staging copy or a preview deployment
# never competes with the real site for its own product pages.
#
# ROADMAP.md opens indexing at launch (Phase 18): set it to "true" there, and
# nowhere else. It is not an access control — every private route is guarded by
# server/auth/guards regardless of what this says (SECURITY.md section 3).
# ---------------------------------------------------------------------------
# SEO_INDEXABLE=true


# ---------------------------------------------------------------------------
# Phase 9 — private object storage (S3-compatible; Cloudflare R2 — ADR-009)
# ---------------------------------------------------------------------------
# Required TOGETHER in production. With none of them set, development and the
# test suite use the filesystem adapter in lib/storage/local.ts, which runs the
# same presign -> PUT -> verify -> promote flow against a temp directory.
# Production refuses to fall back: lib/storage throws with the missing names.
#
# None of these may be NEXT_PUBLIC_. A storage credential in the browser bundle
# is a public bucket with extra steps.
#
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto                  # R2 ignores it; the S3 protocol requires one
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_PRIVATE=              # Customer design files. Public access blocked
#                                 # at the bucket, not merely by object ACL.
# S3_BUCKET_PUBLIC=               # Product photography. Not read yet — admin
#                                 # media management is a later phase.
STORAGE_LOCAL_ROOT=./.storage     # Where the development adapter keeps objects.
#                                 # Defaults to a temp directory, which loses
#                                 # uploaded product photographs on a reboot.
NEXT_PUBLIC_PUBLIC_ASSET_URL=/assets
#   Where public assets are served from: product photography, gallery images.
#   Either a root-relative path — `/assets` serves `public/assets`, which needs
#   no infrastructure and is what this project uses — or a CDN origin such as
#   `https://cdn.example.com/assets`. Unset, every image renders its placeholder.
#   Never used for customer design files; those are private (SECURITY.md 7).
# (was) CDN origin for public assets only. Read from
#                                 # Phase 6 by lib/media: while it is unset,
#                                 # every product image key resolves to null and
#                                 # the media primitives render a placeholder.


# ---------------------------------------------------------------------------
# Phase 15 — rate limiting (not yet read)
# ---------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# CRON_SECRET=
