{
  "name": "stitch",
  "version": "0.1.0",
  "private": true,
  "description": "STITCH — custom embroidery ordering platform, storefront, customer portal and admin.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:admin": "tsx prisma/promote.ts",
    "db:clear": "tsx prisma/clear.ts",
    "jobs:notifications": "tsx scripts/dispatch-notifications.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test:db": "vitest run tests/integration",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.560.0",
    "next": "16.3.4",
    "pg": "8.16.3",
    "prisma": "7.10.0",
    "radix-ui": "1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.4.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.43",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dotenv": "17.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "27.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
