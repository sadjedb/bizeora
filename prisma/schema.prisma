// Bizeora — database schema
//
// Derived from docs/DATABASE.md, which remains the design source of truth.
// Conventions (DATABASE.md section 1):
//   - snake_case in the database, camelCase in application code (@map / @@map)
//   - UUID v7 primary keys, generated by PostgreSQL 18's uuidv7()
//   - money as INTEGER minor units, never float, never numeric
//   - percentages as INTEGER basis points, 10000 = 100% (ADR-018)
//
// Prisma cannot express CHECK constraints or partial (WHERE) indexes. Every
// such rule from DATABASE.md sections 17 and 18 lives in hand-written SQL
// appended to the initial migration, and is listed there with the section it
// implements.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

