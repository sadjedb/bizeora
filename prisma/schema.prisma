model Review {
  id                 String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  orderItemId        String?      @map("order_item_id") @db.Uuid
  rating             Int          @db.SmallInt
  title              String?
  body               String
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
  adminResponse      String?      @map("admin_response")
  moderatedByUserId  String?      @map("moderated_by_user_id") @db.Uuid
  moderatedAt        DateTime?    @map("moderated_at") @db.Timestamptz(6)
  /**
   * Hidden from the workshop's lists, and from nothing else (ADR-034).
   */
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
