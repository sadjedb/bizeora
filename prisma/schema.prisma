  orders Order[]

  @@unique([zoneId, deliveryType])
  @@map("shipping_rates")
}

model Notification {
  id               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String?             @map("user_id") @db.Uuid
  /// What this notification is *about*, as one stable string.
  ///
  /// The outbox's idempotency key (Phase 8A): unique, so writing the same
  /// notification twice is a constraint violation the writer swallows rather
  /// than a second email. Shaped `<template>:<subject id>` — one order
  /// confirmation per order, one expiry warning per quote per audience.
  dedupeKey        String?             @unique @map("dedupe_key")
  channel          NotificationChannel
  template         String
  payload          Json?
  recipient        String?
  relatedOrderId   String?             @map("related_order_id") @db.Uuid
  relatedQuoteId   String?             @map("related_quote_id") @db.Uuid
  relatedRequestId String?             @map("related_request_id") @db.Uuid
  status           NotificationStatus  @default(PENDING)
  attempts         Int                 @default(0)
  lastError        String?             @map("last_error")
  scheduledFor     DateTime            @default(now()) @map("scheduled_for") @db.Timestamptz(6)
  sentAt           DateTime?           @map("sent_at") @db.Timestamptz(6)
  readAt           DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedOrder   Order?         @relation(fields: [relatedOrderId], references: [id], onDelete: Cascade)
  relatedQuote   Quote?         @relation(fields: [relatedQuoteId], references: [id], onDelete: Cascade)
  relatedRequest CustomRequest? @relation(fields: [relatedRequestId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
