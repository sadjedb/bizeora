// 12. Discounts
// ---------------------------------------------------------------------------

/// Quantity discount bands (V1). ADR-017: a table, not a settings JSON value.
/// Non-overlap and full coverage are a SERVICE-LAYER invariant, asserted by
/// test — deliberately not a database constraint (DATABASE.md section 12).
model DiscountTier {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  minQuantity         Int      @map("min_quantity")
  maxQuantity         Int?     @map("max_quantity")
  discountBasisPoints Int      @map("discount_basis_points")
  label               String
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([minQuantity])
  @@map("discount_tiers")
}

/// V1.5 (DATABASE.md section 12). `value` is basis points when
/// type = PERCENTAGE, minor units when type = FIXED_AMOUNT (ADR-018).
model Coupon {
  id                    String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                  String      @unique @db.Citext
  description           String?
  type                  CouponType
  value                 Int
  minimumOrderTotal     Int?        @map("minimum_order_total")
  maximumDiscount       Int?        @map("maximum_discount")
  scope                 CouponScope @default(ALL)
  startsAt              DateTime    @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime?   @map("ends_at") @db.Timestamptz(6)
  usageLimitTotal       Int?        @map("usage_limit_total")
  usageLimitPerCustomer Int?        @map("usage_limit_per_customer")
  usedCount             Int         @default(0) @map("used_count")
  appliesToCustomOrders Boolean     @default(false) @map("applies_to_custom_orders")
  appliesToSaleItems    Boolean     @default(true) @map("applies_to_sale_items")
  isActive              Boolean     @default(true) @map("is_active")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  restrictions CouponRestriction[]
  redemptions  CouponRedemption[]
  carts        Cart[]
  orders       Order[]

  @@map("coupons")
}

model CouponRestriction {
  couponId   String           @map("coupon_id") @db.Uuid
  targetType CouponTargetType @map("target_type")
  targetId   String           @map("target_id") @db.Uuid

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@id([couponId, targetType, targetId])
  @@map("coupon_restrictions")
}

model CouponRedemption {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  couponId         String   @map("coupon_id") @db.Uuid
  orderId          String   @unique @map("order_id") @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  amountDiscounted Int      @map("amount_discounted")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([couponId, orderId])
  @@map("coupon_redemptions")
}

