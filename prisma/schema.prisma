// ---------------------------------------------------------------------------
// 4. Identity and access
//
// `User`, `Session`, `Account` and `Verification` are Better Auth's core schema
// (better-auth 1.7.2), not our own design: the field names and semantics are
// the ones the library's Prisma adapter queries by, so they are not renamed.
// Our domain columns (role, status, phone, marketing consent, soft delete) sit
// alongside them on `users`. See DATABASE.md section 4 and ADR-006.
//
// Two consequences of adopting the native model, accepted deliberately:
//   - `sessions.token` and `verification.value` are stored as issued, not
//     hashed, because Better Auth looks both up by equality on the raw value.
//     They are high-entropy and revocable by row deletion. See SECURITY.md
//     section 2.
//   - The Argon2id credential hash lives on the credential account row
//     (`accounts.password` where `provider_id = 'credential'`), never on
//     `users`.
//
// Primary keys stay `uuidv7()` like every other table, so Phase 3 must
// configure Better Auth to let the database generate identifiers.
// ---------------------------------------------------------------------------

model User {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  // Better Auth core fields.
  name          String
  /// The database index behind this is partial — unique among rows where
  /// `deleted_at IS NULL`, so an anonymised account does not block re-use of
  /// the address. Prisma cannot express the WHERE clause, hence the explicit
  /// map onto the index the migration actually creates.
  email         String  @unique(map: "users_email_active_key") @db.Citext
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?

  // Domain fields.
  phone           String?
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  marketingOptIn  Boolean    @default(false) @map("marketing_opt_in")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  sessions             Session[]
  accounts             Account[]
  addresses            Address[]
  carts                Cart[]
  orders               Order[]
  designFiles          DesignFile[]
  reviews              Review[]              @relation("ReviewAuthor")
  moderatedReviews     Review[]              @relation("ReviewModerator")
  customizationConfigs CustomizationConfig[]
  customRequests       CustomRequest[]       @relation("RequestOwner")
  assignedRequests     CustomRequest[]       @relation("RequestAssignee")
  quotes               Quote[]               @relation("QuoteOwner")
  createdQuotes        Quote[]               @relation("QuoteAuthor")
  notifications        Notification[]
  auditLogs            AuditLog[]
  stockAdjustments     InventoryAdjustment[]
  statusChanges        OrderStatusHistory[]
  requestEvents        CustomRequestEvent[]
  recordedPayments     Payment[]
  submittedProofs      OrderPaymentProof[]   @relation("PaymentProofSubmitter")
  reviewedProofs       OrderPaymentProof[]   @relation("PaymentProofReviewer")
  settingUpdates       Setting[]
  couponRedemptions    CouponRedemption[]
  wishlistItems        WishlistItem[]
  analyticsEvents      AnalyticsEvent[]

  @@index([phone])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

/// Better Auth session. `token` is the value carried in the session cookie and
/// is stored as issued; revocation is deletion of this row. There is no
/// `lastActiveAt` — Better Auth expresses rolling refresh by moving
/// `expiresAt` and `updatedAt`.
model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Better Auth account. One row per credential or provider link.
///
/// For email and password there is exactly one row per user with
/// `providerId = 'credential'`, `accountId` equal to the user id, and the
/// Argon2id hash in `password`. OAuth rows are unused in V1 but the columns
/// exist so adding a provider needs no migration.
model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  /// Better Auth identity namespace, and part of the account identity key.
  /// NOT NULL and non-optional in better-auth 1.7.2: `updatePassword` filters
  /// on it, so a credential row without it can never have its password changed.
  /// Credential accounts carry the synthetic value `local:credential`.
  issuer                String
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Better Auth identifies an account by (issuer, accountId), not by
  /// (providerId, accountId) — verified against the installed 1.7.2 table
  /// definition. See ADR-019.
  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Better Auth verification. One generic table for every short-lived
/// credential: email verification, password reset, and anything a later plugin
/// adds. `identifier` says what the value is for, `value` is the token as
/// issued. There is no `consumedAt` and no type enum — Better Auth consumes a
/// verification by deleting the row inside the same operation that reads it,
/// which is what makes single use atomic. A second competing verification
/// system must not be introduced alongside it.
model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model Wilaya {
  code     Int     @id
  nameFr   String  @map("name_fr")
  nameAr   String  @map("name_ar")
  isActive Boolean @default(true) @map("is_active")

  communes     Commune[]
  addresses    Address[]
  zoneWilaya   ShippingZoneWilaya?
  orderAddress OrderAddress[]

  @@map("wilayas")
}

model Commune {
  id         String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  wilayaCode Int     @map("wilaya_code")
  nameFr     String  @map("name_fr")
  nameAr     String  @map("name_ar")
  isActive   Boolean @default(true) @map("is_active")

  wilaya    Wilaya    @relation(fields: [wilayaCode], references: [code], onDelete: Restrict)
  addresses Address[]

  @@index([wilayaCode])
  @@map("communes")
}

model Address {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  label       String?
  fullName    String   @map("full_name")
  phone       String
  wilayaCode  Int      @map("wilaya_code")
  communeId   String?  @map("commune_id") @db.Uuid
  communeName String   @map("commune_name")
  addressLine String   @map("address_line")
  postalCode  String?  @map("postal_code")
  notes       String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wilaya  Wilaya   @relation(fields: [wilayaCode], references: [code], onDelete: Restrict)
  commune Commune? @relation(fields: [communeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// 5. Catalogue
// ---------------------------------------------------------------------------

model Category {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug           String
  name           String
  description    String?
  imageKey       String?   @map("image_key")
  parentId       String?   @map("parent_id") @db.Uuid
  position       Int       @default(0)
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  parent              Category?            @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children            Category[]           @relation("CategoryTree")
  products            Product[]
  profileProductTypes ProfileProductType[]

  @@index([parentId, position])
  @@index([isActive])
  @@map("categories")
}

/// V1.5 (DATABASE.md section 5). Table created now; unused until then.
model Collection {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug           String
  name           String
  description    String?
  imageKey       String?   @map("image_key")
  position       Int       @default(0)
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  isActive       Boolean   @default(true) @map("is_active")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  products ProductCollection[]

  @@map("collections")
}

model ProductCollection {
  productId    String @map("product_id") @db.Uuid
  collectionId String @map("collection_id") @db.Uuid
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("product_collections")
}

model Product {
  id                     String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug                   String
  name                   String
  subtitle               String?
  description            String
  categoryId             String        @map("category_id") @db.Uuid
  status                 ProductStatus @default(DRAFT)
  basePrice              Int           @map("base_price")
  compareAtPrice         Int?          @map("compare_at_price")
  currency               String        @default("DZD") @db.Char(3)
  stockPolicy            StockPolicy   @default(TRACK) @map("stock_policy")
  material               String?
  careInstructions       String?       @map("care_instructions")
  embroideryDetails      String?       @map("embroidery_details")
  isFeatured             Boolean       @default(false) @map("is_featured")
  isBestSeller           Boolean       @default(false) @map("is_best_seller")
  isNewArrival           Boolean       @default(false) @map("is_new_arrival")
  isCustomizable         Boolean       @default(false) @map("is_customizable")
  customizationProfileId String?       @map("customization_profile_id") @db.Uuid
  ratingAverage          Int?          @map("rating_average")
  ratingCount            Int           @default(0) @map("rating_count")
  seoTitle               String?       @map("seo_title")
  seoDescription         String?       @map("seo_description")
  ogImageKey             String?       @map("og_image_key")
  publishedAt            DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz(6)

  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  customizationProfile CustomizationProfile? @relation(fields: [customizationProfileId], references: [id], onDelete: SetNull)

  options              ProductOption[]
  variants             ProductVariant[]
  images               ProductImage[]
  models3d             ProductModel3d[]
  tags                 ProductTag[]
  collections          ProductCollection[]
  redirects            ProductRedirect[]
  reviews              Review[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  customizationConfigs CustomizationConfig[]
  wishlistItems        WishlistItem[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status])
  @@map("products")
}

model ProductOption {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  optionId String  @map("option_id") @db.Uuid
  value    String
  hexColor String? @map("hex_color")
  position Int     @default(0)

  option        ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantValues ProductVariantOptionValue[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

model ProductVariant {
  id                     String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId              String  @map("product_id") @db.Uuid
  sku                    String  @unique
  priceOverride          Int?    @map("price_override")
  compareAtPriceOverride Int?    @map("compare_at_price_override")
  stockQuantity          Int     @default(0) @map("stock_quantity")
  reservedQuantity       Int     @default(0) @map("reserved_quantity")
  lowStockThreshold      Int?    @map("low_stock_threshold")
  weightGrams            Int?    @map("weight_grams")
  isActive               Boolean @default(true) @map("is_active")
  position               Int     @default(0)

  product              Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues         ProductVariantOptionValue[]
  images               ProductImage[]
  models3d             ProductModel3d[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  customizationConfigs CustomizationConfig[]
  wishlistItems        WishlistItem[]
  adjustments          InventoryAdjustment[]

  @@index([productId])
  @@map("product_variants")
}

/// The stock ledger. Append-only; see ADR-029 and DATABASE.md section 5.
model InventoryAdjustment {
  id                String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  variantId         String                    @map("variant_id") @db.Uuid
  /// Signed and never zero. Positive receives stock, negative removes it.
  delta             Int
  /// The count after this movement, recorded at the time rather than replayed.
  resultingQuantity Int                       @map("resulting_quantity")
  reason            InventoryAdjustmentReason
  note              String?
  actorUserId       String?                   @map("actor_user_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt(sort: Desc)])
  @@map("inventory_adjustments")
}

model ProductVariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("product_variant_option_values")
}

model ProductImage {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  storageKey  String  @map("storage_key")
  alt         String
  position    Int     @default(0)
  width       Int?
  height      Int?
  blurDataUrl String? @map("blur_data_url")
  isPrimary   Boolean @default(false) @map("is_primary")

  /// Which face of the garment this photograph shows, when it is a blank the
  /// builder places designs on. NULL means an ordinary catalogue picture: it
  /// sells the product and nothing is dropped onto it (ADR-035).
  surface DesignSurface? @map("surface")

  /// How wide the garment really is, in millimetres, across the **full width
  /// of this picture**. The one measurement that turns a percentage into
  /// something a workshop can stitch. NULL means unmeasured, and an unmeasured
  /// surface can be looked at but not ordered from.
  surfaceWidthMm Int? @map("surface_width_mm")

  product       Product                       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?               @relation(fields: [variantId], references: [id], onDelete: SetNull)
  anchors       ProductImagePlacementAnchor[]
  placedConfigs CustomizationConfig[]         @relation("ConfigSurface")

  @@index([productId, position])
  /// The builder's own read: "the placeable faces of this blank".
  @@index([productId, surface])
  @@map("product_images")
}

/// A garment modelled in three dimensions, for the builder that spins.
///
/// The 3D half of ADR-035. A model is **optional everywhere**: a blank with a
/// photograph and no model gets the flat editor, a blank with both gets the
/// spinning one, and the placement stored is byte-for-byte the same either way
/// because it was never expressed in the photograph's pixels.
///
/// `surfaceWidthMm` means here what it means on a photograph — how wide the
/// garment really is across the full width of the texture — so the millimetre
/// readout under the canvas is computed by the same function in both renderers.
model ProductModel3d {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  /// Set when the model shows one colourway; NULL when it serves the product.
  variantId String? @map("variant_id") @db.Uuid

  /// The `.glb` in public storage. Binary glTF only — one file, no sidecars,
  /// nothing for a viewer to go and fetch (ADR-036).
  storageKey String @map("storage_key")
  byteSize   Int    @map("byte_size")

  /// The mesh's material whose texture the design is composited into. A model
  /// usually has several — fabric, stitching, a metal eyelet — and only one of
  /// them is the thing you print on.
  materialName String @map("material_name")

  surfaceWidthMm Int? @map("surface_width_mm")

  /// A still of the model, so a list does not have to boot a 3D engine.
  posterKey String? @map("poster_key")

  label     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, isActive])
  @@map("product_models_3d")
}

model ProductImagePlacementAnchor {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productImageId String   @map("product_image_id") @db.Uuid
  placementId    String   @map("placement_id") @db.Uuid
  xPercent       Decimal  @map("x_percent") @db.Decimal(5, 2)
  yPercent       Decimal  @map("y_percent") @db.Decimal(5, 2)
  widthPercent   Decimal  @map("width_percent") @db.Decimal(5, 2)
  rotationDeg    Decimal  @default(0) @map("rotation_deg") @db.Decimal(5, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  productImage ProductImage @relation(fields: [productImageId], references: [id], onDelete: Cascade)
  placement    Placement    @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@unique([productImageId, placementId])
  @@index([productImageId])
  @@map("product_image_placement_anchors")
}

model Tag {
  id   String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug String @unique
