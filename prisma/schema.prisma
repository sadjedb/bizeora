  category Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([profileId, categoryId])
  @@map("profile_product_types")
}

model CustomizationConfig {
  id                  String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerUserId         String? @map("owner_user_id") @db.Uuid
  productId           String? @map("product_id") @db.Uuid
  variantId           String? @map("variant_id") @db.Uuid
  freeformProductType String? @map("freeform_product_type")
  placementId         String? @map("placement_id") @db.Uuid
  customPlacementNote String? @map("custom_placement_note")
  embroiderySizeId    String? @map("embroidery_size_id") @db.Uuid
  embroideryWidthMm   Int?    @map("embroidery_width_mm")
  embroideryHeightMm  Int?    @map("embroidery_height_mm")

  /// Where the customer put it (ADR-035).
  ///
  /// Percentages of the surface, never pixels and never millimetres: the same
  /// four numbers position the design over a photograph and inside a 3D
  /// model's UV map, so a blank that gains a model keeps every configuration
  /// ever saved against it. `x`/`y` are the design's **centre**, which is the
  /// point rotation turns about and a resize keeps still.
  designSurface        DesignSurface? @map("design_surface")
  designSurfaceImageId String?        @map("design_surface_image_id") @db.Uuid
  designXPercent       Decimal?       @map("design_x_percent") @db.Decimal(6, 3)
  designYPercent       Decimal?       @map("design_y_percent") @db.Decimal(6, 3)
  designWidthPercent   Decimal?       @map("design_width_percent") @db.Decimal(6, 3)
  designRotationDeg    Decimal?       @default(0) @map("design_rotation_deg") @db.Decimal(6, 2)
  embroideryText       String?        @map("embroidery_text")
  embroideryFontId     String?        @map("embroidery_font_id") @db.Uuid
  threadColorCount     Int            @default(1) @map("thread_color_count")
  instructions         String?
  pricingMode          PricingMode    @map("pricing_mode")
  pricingModeReason    String?        @map("pricing_mode_reason")
  estimateMin          Int?           @map("estimate_min")
  estimateMax          Int?           @map("estimate_max")
  isTemplate           Boolean        @default(false) @map("is_template")
  label                String?
  frozenAt             DateTime?      @map("frozen_at") @db.Timestamptz(6)
  clonedFromConfigId   String?        @map("cloned_from_config_id") @db.Uuid

  // Display snapshots, written at freeze time (ADR-016)
  productNameSnapshot String?  @map("product_name_snapshot")
  placementLabel      String?  @map("placement_label")
  /// "Devant · 85 × 43 mm", written at freeze time like every other snapshot,
  /// so a quote sent six months ago still reads correctly after the blank's
  /// photograph has been replaced (ADR-016).
  designSurfaceLabel  String?  @map("design_surface_label")
  embroiderySizeLabel String?  @map("embroidery_size_label")
  threadColorNames    String[] @default([]) @map("thread_color_names")
  fontLabel           String?  @map("font_label")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner          User?                 @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  product        Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant        ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  placement      Placement?            @relation(fields: [placementId], references: [id], onDelete: SetNull)
  /// The photograph the design was placed on, so the workshop can be shown the
  /// picture rather than a sentence about it (ADR-035).
  surfaceImage   ProductImage?         @relation("ConfigSurface", fields: [designSurfaceImageId], references: [id], onDelete: SetNull)
  embroiderySize EmbroiderySize?       @relation(fields: [embroiderySizeId], references: [id], onDelete: SetNull)
  font           EmbroideryFont?       @relation(fields: [embroideryFontId], references: [id], onDelete: SetNull)
  clonedFrom     CustomizationConfig?  @relation("ConfigClone", fields: [clonedFromConfigId], references: [id], onDelete: SetNull)
  clones         CustomizationConfig[] @relation("ConfigClone")

  threadColors CustomizationThreadColor[]
  files        CustomizationFile[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  requestItems CustomRequestItem[]

  @@index([ownerUserId, createdAt(sort: Desc)])
  @@index([productId])
  @@index([clonedFromConfigId])
  @@map("customization_configs")
}

model CustomizationThreadColor {
  configId      String @map("config_id") @db.Uuid
  threadColorId String @map("thread_color_id") @db.Uuid
  position      Int    @default(0)

  config      CustomizationConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  threadColor ThreadColor         @relation(fields: [threadColorId], references: [id], onDelete: Restrict)

  @@id([configId, threadColorId])
  @@map("customization_thread_colors")
}

model CustomizationFile {
  configId     String         @map("config_id") @db.Uuid
  designFileId String         @map("design_file_id") @db.Uuid
  role         DesignFileRole @default(PRIMARY)
  position     Int            @default(0)

  config     CustomizationConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  designFile DesignFile          @relation(fields: [designFileId], references: [id], onDelete: Restrict)

  @@id([configId, designFileId])
  @@map("customization_files")
}

model DesignFile {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerUserId      String?          @map("owner_user_id") @db.Uuid
  /// SHA-256 of the guest's anonymous token — the same token that identifies a
  /// guest cart, so one browser is one guest. Exactly one of this and
  /// `ownerUserId` is set on a live row (Phase 9 migration).
  ownerTokenHash   String?          @map("owner_token_hash")
  storageKey       String           @unique @map("storage_key")
  originalFilename String           @map("original_filename")
  mimeType         String           @map("mime_type")
  extension        String
  byteSize         Int              @map("byte_size")
  checksumSha256   String           @map("checksum_sha256")
  width            Int?
  height           Int?
  pageCount        Int?             @map("page_count")
  status           DesignFileStatus @default(PENDING)
  rejectionReason  String?          @map("rejection_reason")
  previewKey       String?          @map("preview_key")
  label            String?
  savedAt          DateTime?        @map("saved_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)

  owner        User?               @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  configs      CustomizationFile[]
  galleryItems GalleryItem[]
  paymentProof OrderPaymentProof?

  @@index([ownerUserId, createdAt(sort: Desc)])
  /// Named explicitly because the Phase 9 migration creates it partial —
  /// `WHERE owner_token_hash IS NOT NULL` — which Prisma cannot express.
  /// Without the map the two disagree on the name alone, and a clean
  /// replay reports drift for an index that is otherwise identical.
  @@index([ownerTokenHash, createdAt(sort: Desc)], map: "design_files_owner_token_hash_idx")
  @@index([checksumSha256])
  @@map("design_files")
}

// ---------------------------------------------------------------------------
// 7. Cart
// ---------------------------------------------------------------------------

model Cart {
  id               String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind             CartKind   @default(STANDARD)
  userId           String?    @map("user_id") @db.Uuid
  anonymousToken   String?    @unique @map("anonymous_token")
  status           CartStatus @default(ACTIVE)
  currency         String     @default("DZD") @db.Char(3)
  quoteId          String?    @unique @map("quote_id") @db.Uuid
  quoteValidUntil  DateTime?  @map("quote_valid_until") @db.Timestamptz(6)
  couponId         String?    @map("coupon_id") @db.Uuid
  couponCode       String?    @map("coupon_code")
  lastActivityAt   DateTime   @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  expiresAt        DateTime?  @map("expires_at") @db.Timestamptz(6)
  convertedOrderId String?    @unique @map("converted_order_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote          Quote?  @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  coupon         Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  convertedOrder Order?  @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)

  items CartItem[]

  @@index([status, lastActivityAt])
  @@map("carts")
}

model CartItem {
  id                    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cartId                String   @map("cart_id") @db.Uuid
  kind                  LineKind
  productId             String?  @map("product_id") @db.Uuid
  variantId             String?  @map("variant_id") @db.Uuid
  customizationConfigId String?  @map("customization_config_id") @db.Uuid
  quoteItemId           String?  @map("quote_item_id") @db.Uuid
  nameSnapshot          String?  @map("name_snapshot")
  lockedUnitPrice       Int?     @map("locked_unit_price")
  quantity              Int
  position              Int      @default(0)
  addedAt               DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  cart                Cart                 @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product             Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant             ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customizationConfig CustomizationConfig? @relation(fields: [customizationConfigId], references: [id], onDelete: SetNull)
  quoteItem           QuoteItem?           @relation(fields: [quoteItemId], references: [id], onDelete: SetNull)

  @@index([cartId, position])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// 8. Orders
// ---------------------------------------------------------------------------

model Order {
  id                    String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderNumber           String        @unique @map("order_number")
  userId                String?       @map("user_id") @db.Uuid
  guestToken            String?       @unique @map("guest_token")
  status                OrderStatus
  paymentStatus         PaymentStatus @default(UNPAID) @map("payment_status")
  currency              String        @default("DZD") @db.Char(3)
  contactName           String        @map("contact_name")
  contactPhone          String        @map("contact_phone")
  /// Optional since Phase 14.11: a cash-on-delivery customer in Algeria often
  /// has no e-mail address, and the phone above is the real contact. An order
  /// without one gets no e-mail confirmation and cannot be claimed by address
  /// later; it is reached by its guest token, and by phone from the workshop.
  contactEmail          String?       @map("contact_email")
  subtotal              Int
  discountTotal         Int           @default(0) @map("discount_total")
  shippingTotal         Int           @default(0) @map("shipping_total")
  taxTotal              Int           @default(0) @map("tax_total")
  grandTotal            Int           @map("grand_total")
  amountPaid            Int           @default(0) @map("amount_paid")
  depositRequired       Int           @default(0) @map("deposit_required")
  couponId              String?       @map("coupon_id") @db.Uuid
  couponCodeSnapshot    String?       @map("coupon_code_snapshot")
  paymentMethod         PaymentMethod @map("payment_method")
  requestId             String?       @map("request_id") @db.Uuid
  quoteId               String?       @unique @map("quote_id") @db.Uuid
  deliveryType          DeliveryType  @map("delivery_type")
  shippingRateId        String?       @map("shipping_rate_id") @db.Uuid
  shippingRateLabel     String?       @map("shipping_rate_label")
  carrierName           String?       @map("carrier_name")
  trackingNumber        String?       @map("tracking_number")
  trackingUrl           String?       @map("tracking_url")
  estimatedDeliveryFrom DateTime?     @map("estimated_delivery_from") @db.Date
  estimatedDeliveryTo   DateTime?     @map("estimated_delivery_to") @db.Date
  customerNote          String?       @map("customer_note")
  internalNotes         String?       @map("internal_notes")
  cancellationReason    String?       @map("cancellation_reason")
  placedAt              DateTime      @default(now()) @map("placed_at") @db.Timestamptz(6)
  confirmedAt           DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  productionStartedAt   DateTime?     @map("production_started_at") @db.Timestamptz(6)
  readyAt               DateTime?     @map("ready_at") @db.Timestamptz(6)
  shippedAt             DateTime?     @map("shipped_at") @db.Timestamptz(6)
  deliveredAt           DateTime?     @map("delivered_at") @db.Timestamptz(6)
  cancelledAt           DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  /**
   * Hidden from the workshop's lists, and from nothing else (ADR-034).
   * Queue hygiene: the record stays exactly as it was, the customer still sees
   * it, the totals still count it. It simply stops appearing in the screens the
   * workshop works from, and one click puts it back.
   */
  archivedAt            DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon       Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  request      CustomRequest? @relation("OrderRequest", fields: [requestId], references: [id], onDelete: SetNull)
  quote        Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  shippingRate ShippingRate?  @relation(fields: [shippingRateId], references: [id], onDelete: SetNull)

  items             OrderItem[]
  addresses         OrderAddress[]
  statusHistory     OrderStatusHistory[]
  payments          Payment[]
  paymentProofs     OrderPaymentProof[]
  cart              Cart?
  convertedRequests CustomRequest[]      @relation("RequestConvertedOrder")
  notifications     Notification[]
  couponRedemption  CouponRedemption?
  galleryItems      GalleryItem[]

  @@index([userId, placedAt(sort: Desc)])
  @@index([status, placedAt(sort: Desc)])
  @@index([paymentStatus])
  @@index([placedAt(sort: Desc)])
  @@index([contactPhone])
  @@index([archivedAt])
  @@map("orders")
}

/// A customer's proof of an offline transfer, awaiting the workshop's review.
///
/// `BUSINESS-RULES.md` 8.10.2: proof is an upload against the **order**, stored
/// under the same private-file rules as design files. It is a row of its own
/// rather than a column on `payments` because it exists *before* a payment
/// does — the customer submits it, and recording the payment is the admin's
/// answer to it (8.10.4).
model OrderPaymentProof {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId           String             @map("order_id") @db.Uuid
  designFileId      String             @unique @map("design_file_id") @db.Uuid
  submittedByUserId String?            @map("submitted_by_user_id") @db.Uuid
  status            PaymentProofStatus @default(SUBMITTED)
  /// Shown to the customer verbatim when a proof is refused (8.10.4).
  rejectionReason   String?            @map("rejection_reason")
  reviewedByUserId  String?            @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  designFile  DesignFile @relation(fields: [designFileId], references: [id], onDelete: Restrict)
  submittedBy User?      @relation("PaymentProofSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy  User?      @relation("PaymentProofReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_payment_proofs")
}

model OrderItem {
  id                    String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId               String         @map("order_id") @db.Uuid
  kind                  LineKind
  feeKind               QuoteLineKind? @map("fee_kind")
  productId             String?        @map("product_id") @db.Uuid
  variantId             String?        @map("variant_id") @db.Uuid
  customizationConfigId String?        @map("customization_config_id") @db.Uuid
  quoteItemId           String?        @map("quote_item_id") @db.Uuid
  nameSnapshot          String         @map("name_snapshot")
  variantLabelSnapshot  String?        @map("variant_label_snapshot")
  skuSnapshot           String?        @map("sku_snapshot")
  imageKeySnapshot      String?        @map("image_key_snapshot")
  unitPrice             Int            @map("unit_price")
  quantity              Int
  lineDiscount          Int            @default(0) @map("line_discount")
  lineTotal             Int            @map("line_total")
  requiresProduction    Boolean        @default(false) @map("requires_production")
  position              Int            @default(0)

  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant             ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customizationConfig CustomizationConfig? @relation(fields: [customizationConfigId], references: [id], onDelete: SetNull)
  quoteItem           QuoteItem?           @relation(fields: [quoteItemId], references: [id], onDelete: SetNull)

  reviews Review[]

  @@index([orderId, position])
  @@map("order_items")
}

model OrderAddress {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId            String           @map("order_id") @db.Uuid
  type               OrderAddressType
  fullName           String           @map("full_name")
  phone              String
  wilayaCode         Int              @map("wilaya_code")
  wilayaNameSnapshot String           @map("wilaya_name_snapshot")
  communeName        String           @map("commune_name")
  addressLine        String           @map("address_line")
  postalCode         String?          @map("postal_code")
  notes              String?

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wilaya Wilaya @relation(fields: [wilayaCode], references: [code], onDelete: Restrict)

  @@unique([orderId, type])
  @@map("order_addresses")
}

model OrderStatusHistory {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId           String       @map("order_id") @db.Uuid
  fromStatus        OrderStatus? @map("from_status")
  toStatus          OrderStatus  @map("to_status")
  actorType         ActorType    @map("actor_type")
  actorUserId       String?      @map("actor_user_id") @db.Uuid
  note              String?
  isCustomerVisible Boolean      @default(true) @map("is_customer_visible")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  provider          String
  method            PaymentMethod
  kind              PaymentKind
  amount            Int
  currency          String          @default("DZD") @db.Char(3)
  status            PaymentTxStatus @default(PENDING)
  providerReference String?         @map("provider_reference")
  idempotencyKey    String?         @unique @map("idempotency_key")
  rawPayload        Json?           @map("raw_payload")
  capturedAt        DateTime?       @map("captured_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  recordedByUserId  String?         @map("recorded_by_user_id") @db.Uuid

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy User? @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([providerReference])
  /// 8.8 sums the succeeded rows per order, and the admin queue reads the
  /// outstanding ones; both are answered from this index.
  @@index([orderId, status], map: "payments_order_status_idx")
  @@map("payments")
}

// ---------------------------------------------------------------------------
// 9. Custom requests
// ---------------------------------------------------------------------------

model CustomRequest {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestNumber    String               @unique @map("request_number")
  userId           String?              @map("user_id") @db.Uuid
  draftToken       String?              @unique @map("draft_token")
  status           RequestStatus        @default(DRAFT)
  source           RequestSource
  pricingMode      PricingMode          @map("pricing_mode")
  contactName      String?              @map("contact_name")
  contactPhone     String?              @map("contact_phone")
  contactEmail     String?              @map("contact_email")
  preferredChannel NotificationChannel? @map("preferred_channel")
  estimateMin      Int?                 @map("estimate_min")
  estimateMax      Int?                 @map("estimate_max")
  customerNote     String?              @map("customer_note")
  internalNotes    String?              @map("internal_notes")
  needsInfoReason  String?              @map("needs_info_reason")
  assignedToUserId String?              @map("assigned_to_user_id") @db.Uuid
  submittedAt      DateTime?            @map("submitted_at") @db.Timestamptz(6)
  reviewedAt       DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  quotedAt         DateTime?            @map("quoted_at") @db.Timestamptz(6)
  respondedAt      DateTime?            @map("responded_at") @db.Timestamptz(6)
  convertedAt      DateTime?            @map("converted_at") @db.Timestamptz(6)
  expiresAt        DateTime?            @map("expires_at") @db.Timestamptz(6)
  convertedOrderId String?              @map("converted_order_id") @db.Uuid
  /**
   * Hidden from the workshop's lists, and from nothing else (ADR-034).
   */
  archivedAt       DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User?  @relation("RequestOwner", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo     User?  @relation("RequestAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  convertedOrder Order? @relation("RequestConvertedOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)

  items         CustomRequestItem[]
  events        CustomRequestEvent[]
  quotes        Quote[]
  orders        Order[]              @relation("OrderRequest")
  notifications Notification[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([assignedToUserId])
  @@index([archivedAt])
  @@map("custom_requests")
}

model CustomRequestItem {
  id                    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestId             String @map("request_id") @db.Uuid
  customizationConfigId String @map("customization_config_id") @db.Uuid
  quantity              Int
  estimateMin           Int?   @map("estimate_min")
  estimateMax           Int?   @map("estimate_max")
  position              Int    @default(0)

  request             CustomRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customizationConfig CustomizationConfig @relation(fields: [customizationConfigId], references: [id], onDelete: Restrict)

  quoteItems QuoteItem[]

  @@index([requestId, position])
  @@map("custom_request_items")
}

model CustomRequestEvent {
  id                String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestId         String           @map("request_id") @db.Uuid
  type              RequestEventType
  fromStatus        RequestStatus?   @map("from_status")
  toStatus          RequestStatus?   @map("to_status")
  actorType         ActorType        @map("actor_type")
  actorUserId       String?          @map("actor_user_id") @db.Uuid
  message           String?
  isCustomerVisible Boolean          @default(true) @map("is_customer_visible")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  request CustomRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("custom_request_events")
}

// ---------------------------------------------------------------------------
// 10. Quotes
// ---------------------------------------------------------------------------

model Quote {
  id                   String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  quoteNumber          String      @unique @map("quote_number")
  requestId            String      @map("request_id") @db.Uuid
  userId               String      @map("user_id") @db.Uuid
  version              Int         @default(1)
  supersedesQuoteId    String?     @unique @map("supersedes_quote_id") @db.Uuid
  status               QuoteStatus @default(DRAFT)
  currency             String      @default("DZD") @db.Char(3)
  subtotal             Int
  discountTotal        Int         @default(0) @map("discount_total")
  shippingTotal        Int         @default(0) @map("shipping_total")
  taxTotal             Int         @default(0) @map("tax_total")
  grandTotal           Int         @map("grand_total")
  depositRequired      Int         @default(0) @map("deposit_required")
  validUntil           DateTime    @map("valid_until") @db.Timestamptz(6)
  customerMessage      String?     @map("customer_message")
  internalNotes        String?     @map("internal_notes")
  rejectionReason      String?     @map("rejection_reason")
  createdByUserId      String      @map("created_by_user_id") @db.Uuid
  sentAt               DateTime?   @map("sent_at") @db.Timestamptz(6)
  viewedAt             DateTime?   @map("viewed_at") @db.Timestamptz(6)
  respondedAt          DateTime?   @map("responded_at") @db.Timestamptz(6)
  acceptedAt           DateTime?   @map("accepted_at") @db.Timestamptz(6)
  rejectedAt           DateTime?   @map("rejected_at") @db.Timestamptz(6)
  acceptanceValidUntil DateTime?   @map("acceptance_valid_until") @db.Timestamptz(6)
  /**
   * Hidden from the workshop's lists, and from nothing else (ADR-034).
   */
  archivedAt           DateTime?   @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  request      CustomRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user         User          @relation("QuoteOwner", fields: [userId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("QuoteAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  supersedes   Quote?        @relation("QuoteVersion", fields: [supersedesQuoteId], references: [id], onDelete: SetNull)
  supersededBy Quote?        @relation("QuoteVersion")

  items         QuoteItem[]
  cart          Cart?
  order         Order?
  notifications Notification[]

  @@unique([requestId, version])
  @@index([userId, createdAt(sort: Desc)])
  @@index([archivedAt])
  @@map("quotes")
}

model QuoteItem {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  quoteId       String        @map("quote_id") @db.Uuid
  requestItemId String?       @map("request_item_id") @db.Uuid
  kind          QuoteLineKind
  label         String
  description   String?
  quantity      Int           @default(1)
  unitPrice     Int           @map("unit_price")
  lineTotal     Int           @map("line_total")
  position      Int           @default(0)

  quote       Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  requestItem CustomRequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([quoteId, position])
  @@map("quote_items")
}

